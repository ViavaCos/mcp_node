# mcp-server/deploy/nginx.conf.example
# 路线 A 远程部署示例：TLS 终止 + 反向代理
#
# 重要变化：鉴权已交由 mcp-server 自身完成（OAuth 2.1 资源服务器，校验 Bearer JWT）。
#   nginx 只做 TLS 与转发，不再做令牌比对；因此客户端须带 Authorization: Bearer <JWT>。
#
# 采用两个独立域名：MCP 资源域 与 授权服务器域。
#   - MCP 域需可访问 /.well-known/oauth-protected-resource（RFC 9728 发现文档），故整站转发
#   - 授权服务器独立域名，其 issuer 必须与 AUTH_ISSUER 完全一致
#
# 用法：
#   1) 将 server_name 与证书路径改为你的域名与证书
#   2) 本文件放到 nginx 的 conf.d/ 下并 reload
#
# 客户端接入地址即：https://mcp.example.com/mcp
# 令牌由 https://auth.example.com 颁发（issuer 需与 mcp-server 的 AUTH_ISSUER 相同）

# ---- MCP 资源服务器（含 RFC 9728 元数据端点）----
server {
    listen 443 ssl;
    http2 on;
    server_name mcp.example.com;

    ssl_certificate     /etc/ssl/certs/fullchain.pem;
    ssl_certificate_key /etc/ssl/private/privkey.pem;

    # 大请求体（工具参数/响应可能较大）
    client_max_body_size 8m;

    location / {
        proxy_pass http://127.0.0.1:8089;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Streamable HTTP 需要 1.1 + 关闭缓冲（SSE 流式响应）
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_buffering    off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

# ---- 授权服务器（OIDC 发现 / JWKS / 授权 / 令牌）----
server {
    listen 443 ssl;
    http2 on;
    server_name auth.example.com;

    ssl_certificate     /etc/ssl/certs/fullchain.pem;
    ssl_certificate_key /etc/ssl/private/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# 可选：HTTP 80 强制跳转 HTTPS
server {
    listen 80;
    server_name mcp.example.com auth.example.com;
    return 301 https://$host$request_uri;
}
